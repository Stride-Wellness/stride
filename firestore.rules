rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ====================================================================
    // HELPER FUNCTIONS
    // ====================================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user exists in users collection
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Check if user has specific provider role
    function hasProviderRole(role) {
      return userExists() && 
             getUserData().type == 'provider' && 
             role in getUserData().providerRole;
    }
    
    // Check if user is admin of their organization
    function isOrgAdmin() {
      return hasProviderRole('admin');
    }

    // Check if user is manager
    function isManager() {
      return hasProviderRole('manager');
    }

    // Check if user is PSW or LW
    function isProvider() {
      return hasProviderRole('psw') || hasProviderRole('lw');
    }

    // Check if user is client
    function isClient() {
      return userExists() && getUserData().type == 'client';
    }

    // Check if user belongs to specific organization
    function belongsToOrganization(orgId) {
      return userExists() && getUserData().organizationId == orgId;
    }

    // Check if user belongs to specific division
    function belongsToDivision(divId) {
      return userExists() && getUserData().divisionId == divId;
    }

    // Check if admin has sufficient privilege level
    function isAdminWithPrivilege(level) {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
      get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.privilege <= level;
    }

    // Check if user is assigned to a specific client
    function isAssignedToClient(clientId) {
      // Complex query validation - handled at service layer
      return true;
    }

    // Check if user has active assignments (blocking hard delete)
    function hasActiveAssignments(userId) {
      // Complex query validation - handled at service layer  
      return false;
    }

    // Check if division has active users (blocking hard delete)
    function hasActiveUsersInDivision(divisionId) {
      // Complex query validation - handled at service layer
      return false;
    }

    // Check if organization has active divisions/users (blocking hard delete)
    function hasActiveDependencies(orgId) {
      // Complex query validation - handled at service layer
      return false;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate enum values
    function isValidUserStatus(status) {
      return status in ['active', 'inactive', 'pending', 'deleted'];
    }

    function isValidDivisionStatus(status) {
      return status in ['active', 'inactive', 'deleted'];
    }

    function isValidOrganizationStatus(status) {
      return status in ['active', 'suspended', 'cancelled', 'deleted'];
    }

    function isValidAssignmentStatus(status) {
      return status in ['active', 'inactive', 'completed'];
    }

    function isValidProviderRole(role) {
      return role in ['psw', 'lw', 'admin', 'manager'];
    }

    function isValidDivisionType(divType) {
      return divType in ['retirement_home', 'homecare_provider'];
    }

    function isValidMobility(mobility) {
      return mobility in ['independent', 'cane', 'walker', 'wheelchair'];
    }

    // ====================================================================
    // ORGANIZATIONS COLLECTION
    // ====================================================================
    match /organizations/{orgId} {
      // Only organization admins can edit their organization data
      // Any authenticated user can read their organization name
      allow read: if isAuthenticated() && (belongsToOrganization(orgId) ||
                                           isAdminWithPrivilege(3));
      
      // Only site admins can create organizations
      allow create: if validateOrganizationCreation();
      // don't need this stuff to create an org, should put email verify to prevent spam
      // isAuthenticated() && 
      //                  isAdminWithPrivilege(2) &&
      
      allow delete: if isAuthenticated() && 
                       ((belongsToOrganization(orgId) && 
                         isOrgAdmin()) || isAdminWithPrivilege(2)) &&
                       !hasActiveDependencies(orgId);

      // Validation for organization updates (including soft delete)
      allow update: if isAuthenticated() && 
                       ((belongsToOrganization(orgId) && 
                         isOrgAdmin() &&
                         // Prevent changing critical fields
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['name', 'settings', 'status', 'deletedAt', 'updatedAt']) &&
                         // Validate status if changed
                         (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                          isValidOrganizationStatus(request.resource.data.status)) &&
                         // Ensure updatedAt is set
                         request.resource.data.updatedAt == request.time) || 
                        isAdminWithPrivilege(2));
      
      function validateOrganizationCreation() {
        return hasRequiredFields(['name', 'totalSeats', 'status', 'stripeUserId']) &&
               isValidOrganizationStatus(request.resource.data.status) &&
               request.resource.data.totalSeats > 0 &&
               request.resource.data.usedSeats >= 0 &&
               request.resource.data.usedSeats <= request.resource.data.totalSeats;
      }
    }

    // ====================================================================
    // USERS COLLECTION
    // ====================================================================
    match /users/{userId} {
      // Users can read their own data
      // Providers can read clients they are assigned to
      // Managers and admins can read users in their organization
      allow read: if true || isAuthenticated() && (
      // User reading their own data
      request.auth.uid == userId ||
      // Manager/admin reading users in their organization
      (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
      // Provider reading assigned client
      (isProvider() && resource.data.type == 'client' && isAssignedToClient(userId)) ||
      // Site admin access
      isAdminWithPrivilege(3)
      );

      // Users can update their own profile
      // Managers and admins can update users in their organization
      allow update: if true;
      // isAuthenticated()
      // User updating their own profile (limited fields)
      // request.auth.uid == userId;
      // && 
      // request.resource.data.diff(resource.data).affectedKeys()
      // .hasOnly(['profile', 'lastLoginAt', 'updatedAt']) &&
      // // Validate status if changed
      // (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
      //  isValidUserStatus(request.resource.data.status))) ||
      // // Manager/admin updating users in their organization
      // (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin()) &&
      // validateUserUpdate()) ||
      // // Site admin access
      // isAdminWithPrivilege(2)
      // );

      // Only managers and admins can create new users
      allow create: if validateUserCreation() || true;
      // same as organization create condition
      // isAuthenticated() && (
      // (isManager() || isOrgAdmin()) ||
      // isAdminWithPrivilege(2)
      // ) &&

      // Only managers and admins can delete users
      // Hard delete is blocked if user has active assignments
      allow delete: if isAuthenticated() && (
      (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
      isAdminWithPrivilege(2)
      ) && !hasActiveAssignments(userId);

      // User creation validation
      function validateUserCreation() {
        return hasRequiredFields(['email', 'name', 'type', 'organizationId', 'divisionId', 'status']) &&
               request.resource.data.email.matches('.*@.*\\..*') &&
               request.resource.data.type in ['provider', 'client'] &&
               isValidUserStatus(request.resource.data.status) &&
               // Organization must exist
               exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
               // Division must exist
               exists(/databases/$(database)/documents/divisions/$(request.resource.data.divisionId)) &&
               // Division must belong to the specified organization
               get(/databases/$(database)/documents/divisions/$(request.resource.data.divisionId)).data.organizationId == request.resource.data.organizationId &&
               // If provider, must have valid roles and role assignment permissions
               (request.resource.data.type != 'provider' || (
                 validateProviderRoles(request.resource.data.providerRole)
               )) &&
               // User must belong to creator's organization (unless site admin)
               (isAdminWithPrivilege(2) || belongsToOrganization(request.resource.data.organizationId)) &&
               // Validate client profile if client
               (request.resource.data.type != 'client' || validateClientProfile());
      }

      // Validate provider roles and permissions
      function validateProviderRoles(roles) {
        return roles.size() > 0 &&
               roles.toSet().hasOnly(['psw', 'lw', 'admin', 'manager'].toSet()) &&
               // Only admins can assign admin/manager roles (unless site admin)
               (isAdminWithPrivilege(2) || isOrgAdmin() || 
                !roles.toSet().hasAny(['admin', 'manager'].toSet()));
      }

      // Validate user updates
      function validateUserUpdate() {
        return // Validate status if changed
               (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                isValidUserStatus(request.resource.data.status)) &&
               // Validate provider roles if changed
               (!('providerRole' in request.resource.data.diff(resource.data).affectedKeys()) ||
                resource.data.type != 'provider' ||
                validateProviderRoles(request.resource.data.providerRole)) &&
               // Validate profile changes
               (!('profile' in request.resource.data.diff(resource.data).affectedKeys()) ||
                (resource.data.type == 'client' && validateClientProfile()) ||
                resource.data.type == 'provider');
      }

      // Validate client profile medical info
      function validateClientProfile() {
        return !('profile' in request.resource.data) ||
               !('medicalInfo' in request.resource.data.profile) ||
               !('mobility' in request.resource.data.profile.medicalInfo) ||
               isValidMobility(request.resource.data.profile.medicalInfo.mobility);
      }
      
      match /quiz_results/{resultId} {
      	allow read, write: if true;
      }
    }

    // ====================================================================
    // DIVISIONS COLLECTION
    // ====================================================================
    match /divisions/{divisionId} {
      // Any authenticated user can read divisions in their organization
      allow read: if isAuthenticated() 
      
      // && (
      //   belongsToOrganization(resource.data.organizationId) ||
      //   isAdminWithPrivilege(3)
      // );

      // Only managers and admins can create divisions
      allow create: if validateDivisionCreation();
      // same as organization condition
      // isAuthenticated() && (
      //   (isManager() || isOrgAdmin()) ||
      //   isAdminWithPrivilege(2)
      // ) &&

      // Only managers and admins can update divisions
      allow update: if isAuthenticated() && (
        (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
        isAdminWithPrivilege(2)
      ) && validateDivisionUpdate();

      // Only managers and admins can delete divisions
      // Hard delete is blocked if there are active users in the division
      allow delete: if isAuthenticated() && (
        (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
        isAdminWithPrivilege(2)
      ) && !hasActiveUsersInDivision(divisionId);

      function validateDivisionCreation() {
        return hasRequiredFields(['organizationId', 'name', 'divisionType', 'status']) &&
               isValidDivisionType(request.resource.data.divisionType) &&
               isValidDivisionStatus(request.resource.data.status) &&
               // Organization must exist
               exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
               // Manager validation (if provided)
               validateDivisionManager()
               // Creator must belong to the organization (unless site admin)
               // (isAdminWithPrivilege(2) || belongsToOrganization(request.resource.data.organizationId));
      }

      function validateDivisionManager() {
        return // If managerId is null, it's allowed (for initial setup)
               request.resource.data.managerId == null ||
               // If managerId is provided, validate it
               (exists(/databases/$(database)/documents/users/$(request.resource.data.managerId)) &&
                // Manager must belong to the same organization
                get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.organizationId == request.resource.data.organizationId &&
                // Manager must have manager role
                get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.type == 'provider' &&
                'manager' in get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.providerRole);
      }

      function validateDivisionUpdate() {
        return // Validate status if changed
               (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                isValidDivisionStatus(request.resource.data.status)) &&
               // Validate division type if changed
               (!('divisionType' in request.resource.data.diff(resource.data).affectedKeys()) ||
                isValidDivisionType(request.resource.data.divisionType)) &&
               // Validate manager if changed
               (!('managerId' in request.resource.data.diff(resource.data).affectedKeys()) ||
                validateManagerAssignment(request.resource.data.managerId, resource.data.organizationId));
      }

      function validateManagerAssignment(managerId, orgId) {
        return exists(/databases/$(database)/documents/users/$(managerId)) &&
               get(/databases/$(database)/documents/users/$(managerId)).data.organizationId == orgId &&
               get(/databases/$(database)/documents/users/$(managerId)).data.type == 'provider' &&
               'manager' in get(/databases/$(database)/documents/users/$(managerId)).data.providerRole;
      }
    }

    // ====================================================================
    // ASSIGNMENTS COLLECTION
    // ====================================================================
    match /assignments/{assignmentId} {
      // Providers and clients can read their assignments
      // Managers and admins can read assignments in their organization
      allow read: if isAuthenticated() && (
      // Provider or client involved in assignment
      request.auth.uid == resource.data.providerId ||
      request.auth.uid == resource.data.clientId || isAdminWithPrivilege(3)
      // ||
      // // Manager/admin in same organization
      // (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
      // // Site admin access
      // isAdminWithPrivilege(3)
      );

      // Only managers and admins can create assignments
      allow create: if isAuthenticated() && (
      (isManager() || isOrgAdmin()) ||
      isAdminWithPrivilege(2)
      ) && validateAssignmentCreation();

      // Providers can delete their own assignments
      // Managers and admins can delete any assignments in their organization
      allow delete: if isAuthenticated() && (
      // Provider deleting their own assignment
      request.auth.uid == resource.data.providerId ||
      // Manager/admin deleting assignments in their organization
      (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
      // Site admin access
      isAdminWithPrivilege(2)
      );

      // Only managers and admins can update assignments
      allow update: if isAuthenticated() && (
      (belongsToOrganization(resource.data.organizationId) && (isManager() || isOrgAdmin())) ||
      isAdminWithPrivilege(2)
      ) && validateAssignmentUpdate();

      function validateAssignmentCreation() {
      	return true
        // return hasRequiredFields(['clientId', 'providerId', 'divisionId', 'assignedBy', 'status']) &&
        //        isValidAssignmentStatus(request.resource.data.status) &&
        //        // Division must exist
        //        exists(/databases/$(database)/documents/divisions/$(request.resource.data.divisionId)) &&
        //        // Client and provider must exist
        //        exists(/databases/$(database)/documents/users/$(request.resource.data.clientId)) &&
        //        exists(/databases/$(database)/documents/users/$(request.resource.data.providerId)) &&
        //        // Get division data to determine organization
        //        validateAssignmentUsersInSameDivision() &&
        //        // Client must be client type and provider must be provider type
        //        get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.type == 'client' &&
        //        get(/databases/$(database)/documents/users/$(request.resource.data.providerId)).data.type == 'provider' &&
        //        // Provider must have PSW or LW role
        //        (get(/databases/$(database)/documents/users/$(request.resource.data.providerId)).data.providerRole.hasAny(['psw', 'lw'])) &&
        //        // Creator must belong to organization (unless site admin)
        //        (isAdminWithPrivilege(2) || validateAssignmentCreatorPermissions()) &&
        //        // Validate permissions if provided
        //        (!('permissions' in request.resource.data) || validateAssignmentPermissions());
      }

      function validateAssignmentUsersInSameDivision() {
        let division = get(/databases/$(database)/documents/divisions/$(request.resource.data.divisionId));
        let client = get(/databases/$(database)/documents/users/$(request.resource.data.clientId));
        let provider = get(/databases/$(database)/documents/users/$(request.resource.data.providerId));
        
        return // All users must belong to the same organization (via division)
               client.data.organizationId == division.data.organizationId &&
               provider.data.organizationId == division.data.organizationId &&
               // All users must belong to the same division
               client.data.divisionId == request.resource.data.divisionId &&
               provider.data.divisionId == request.resource.data.divisionId;
      }

      function validateAssignmentCreatorPermissions() {
        let division = get(/databases/$(database)/documents/divisions/$(request.resource.data.divisionId));
        return belongsToOrganization(division.data.organizationId);
      }

      function validateAssignmentUpdate() {
        return // Validate status if changed
               (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                isValidAssignmentStatus(request.resource.data.status)) &&
               // Validate permissions if changed
               (!('permissions' in request.resource.data.diff(resource.data).affectedKeys()) ||
                validateAssignmentPermissions());
      }

      function validateAssignmentPermissions() {
        return hasRequiredFields(['canModifyExercises', 'canViewMedicalInfo', 'canScheduleSessions']) &&
               request.resource.data.permissions.canModifyExercises is bool &&
               request.resource.data.permissions.canViewMedicalInfo is bool &&
               request.resource.data.permissions.canScheduleSessions is bool;
      }
    }

    // ====================================================================
    // ADMINS COLLECTION (Site Maintainers)
    // ====================================================================
    match /admins/{adminId} {
      // Any admin can read other admins
      allow read: if isAuthenticated() 
      // && 
      // (true || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

      // Only super admins (level 0) can create new admins
      allow create: if isAuthenticated() && 
      isAdminWithPrivilege(0) &&
      validateAdminCreation();

      // Admins can update other admins based on privilege levels
      allow update: if isAuthenticated() && 
      exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
      validateAdminUpdate();

      // Only super admins can delete admins
      // Level 1+ admins cannot delete admins at their level or below
      allow delete: if isAuthenticated() && 
      isAdminWithPrivilege(0) ||
      (isAdminWithPrivilege(1) && resource.data.privilege > 1);

      function validateAdminCreation() {
        return hasRequiredFields(['name', 'privilege', 'createdBy']) &&
        request.resource.data.privilege in [0, 1, 2, 3] &&
        request.resource.data.createdBy == request.auth.uid &&
        // Only super admins can create level 0 admins
        (request.resource.data.privilege > 0 || isAdminWithPrivilege(0)) &&
        // Admins can only create admins at their level or higher number (lower privilege)
        (isAdminWithPrivilege(0) || 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.privilege < request.resource.data.privilege);
      }

      function validateAdminUpdate() {
        let currentAdminPrivilege = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.privilege;
        let targetAdminPrivilege = resource.data.privilege;
        let newPrivilege = request.resource.data.privilege;

        return // Super admins can update anyone
               currentAdminPrivilege == 0 || 
               // Level 1 admins can update level 2+ admins
               (currentAdminPrivilege == 1 && targetAdminPrivilege > 1) ||
               // Admins can update admins at same or lower privilege level (higher number)
               (currentAdminPrivilege <= targetAdminPrivilege) &&
               // Cannot promote someone to higher privilege than yourself
               (currentAdminPrivilege == 0 || newPrivilege >= currentAdminPrivilege) &&
               // Validate privilege level
               newPrivilege in [0, 1, 2, 3];
      }
    }

    match /exercises/{exerciseId} {
      allow read : if true;
      allow write: if true;
    }

    match /invitations/{invitationId} {
      allow read, write: if true;
    }
    // ====================================================================
    // DEFAULT DENY RULE
    // ====================================================================
    // Deny access to any other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
